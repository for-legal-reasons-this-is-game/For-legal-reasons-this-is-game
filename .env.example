# =============================================================================
#  ft_transcendence - single environment file.
#
#  Copy to `.env` (or drop your own `.env` here) before running `make`.
#  `make` copies this file to `.env` automatically if you don't provide one.
#
#  The values below are throwaway dev defaults - fine for local runs and for
#  the evaluation, but generate your own for anything real:
#    openssl rand -hex 16     (INFISICAL_ENCRYPTION_KEY - must be 32 hex chars)
#    openssl rand -base64 32  (INFISICAL_AUTH_SECRET)
#
#  INFISICAL_ENCRYPTION_KEY / INFISICAL_AUTH_SECRET must never change once an
#  instance has been bootstrapped, or its stored secrets become undecryptable.
# =============================================================================

# ── compose / infrastructure (non-secret) ───────────────────────────────────
BACKEND_PORT=8000
DB_PORT=5432
INFISICAL_PORT=8080
TB_PORT_0=3001
TB_PORT_1=3002
TB_PORT_2=3003
TB_CLUSTER_ID=112369905620179595468860499864441504024
TB_IP_ADRESSES=172.28.0.10:3000,172.28.0.11:3000,172.28.0.12:3000
TB_SUBNET=172.28.0.0/24
TB_REPLICA_0_IP=172.28.0.10
TB_REPLICA_1_IP=172.28.0.11
TB_REPLICA_2_IP=172.28.0.12

# ── Infisical server itself ─────────────────────────────────────────────────
INFISICAL_ENCRYPTION_KEY=aead0cabb3f53167bf189723775a6726
INFISICAL_AUTH_SECRET=swphzstCmA6KTyM8NY0v20KmpsFV9MlCmhtJlSEMWuk=
INFISICAL_DB_PASSWORD=a00d6622660d0fd5fce7fe0eb3e81afe46e920015b5824d1
INFISICAL_SITE_URL=http://localhost:8080

# Automated bootstrap: first admin + organization (see scripts/init.sh)
INFISICAL_ADMIN_EMAIL=admin@transcendence.com
INFISICAL_ADMIN_PASSWORD=9a2466a01fa89fbf7ff260ecc6f96aa6aA1!
INFISICAL_ORG_NAME=Transcendence
INFISICAL_PROJECT_NAME=transcendence
INFISICAL_PROJECT_SLUG=transcendence
INFISICAL_ENV=prod

# ── application secrets ─────────────────────────────────────────────────────
#  INFISICAL_APP_SECRETS lists which keys below are pushed into Infisical on
#  `make up`. Application services read them from Infisical at runtime via
#  `infisical run` - they never see this file. Add a key here + to the list
#  when a new microservice needs a secret.
INFISICAL_APP_SECRETS="DATABASE_URL POSTGRES_USER POSTGRES_PASSWORD POSTGRES_DB TB_CLUSTER_ID TB_IP_ADRESSES"

POSTGRES_USER=transcendence
POSTGRES_PASSWORD=bc8a4b67a82de5da7acef95e450bf2151a5b4e4bdd90d350
POSTGRES_DB=transcendence
DATABASE_URL=postgres://transcendence:bc8a4b67a82de5da7acef95e450bf2151a5b4e4bdd90d350@db:5432/transcendence
